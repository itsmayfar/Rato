# ── Required ────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://mayfar:mayfar@localhost:5432/mayfar

# ── Accounts ────────────────────────────────────────────────
# Allow new accounts after the first one is created (first sign-up is always allowed).
ALLOW_SIGNUP=false

# ── File storage ────────────────────────────────────────────
# Local directory for uploaded documents and audio (outside the web root).
STORAGE_DIR=./storage
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=200

# ── AI assistant (optional) ────────────────────────────────
# Without a key the assistant runs in "offline mode" using stored data only.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Server-side refusal fallbacks ("default" or "off")
AI_REFUSAL_FALLBACK=default
# Optional: prices per million tokens for cost estimates shown in Settings → AI
AI_PRICE_INPUT_PER_MTOK=5
AI_PRICE_OUTPUT_PER_MTOK=25
# Soft cap on assistant requests per user per day.
AI_DAILY_REQUEST_LIMIT=200

# ── Automations ─────────────────────────────────────────────
# Shared secret for POST /api/cron/automations (call from a scheduler).
CRON_SECRET=

# ── Integrations (optional) ─────────────────────────────────
# Spotify Web API (client credentials) – public catalog/artist metadata only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 key – public channel statistics.
YOUTUBE_API_KEY=
