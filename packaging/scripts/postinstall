#!/bin/sh
# RATO by MAYFAR: make the freshly installed plugins loadable and refresh the Audio Unit cache.
for p in "/Library/Audio/Plug-Ins/VST3/RATO.vst3" "/Library/Audio/Plug-Ins/Components/RATO.component" "/Applications/RATO.app"; do
    [ -e "$p" ] && xattr -dr com.apple.quarantine "$p" 2>/dev/null
done
killall -9 AudioComponentRegistrar 2>/dev/null
exit 0
